<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Bengg 💜</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #f0ddff, #c58cff, #8e44d8);
  overflow: hidden;
}

.container {
  width: 92%;
  max-width: 430px;
  min-height: 650px;
  padding: 28px 22px;
  background: rgba(255,255,255,.28);
  backdrop-filter: blur(14px);
  border: 2px solid rgba(255,255,255,.6);
  border-radius: 30px;
  box-shadow: 0 18px 45px rgba(60,20,100,.3);
  text-align: center;
  position: relative;
}

.page {
  display: none;
  animation: fade .45s ease;
}

.page.active {
  display: block;
}

@keyframes fade {
  from {
    opacity: 0;
    transform: translateX(20px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

h1 {
  color: #64249e;
  margin: 25px 0;
  font-size: 29px;
}

.message {
  color: #48205f;
  font-size: 16px;
  line-height: 1.65;
  font-weight: 600;
}

.photo {
  width: 100%;
  height: 290px;
  object-fit: cover;
  margin-top: 15px;
  border: 5px solid white;
  border-radius: 22px;
  box-shadow: 0 8px 20px rgba(60,20,100,.25);
}

.two {
  display: flex;
  gap: 10px;
}

.two .photo {
  width: 50%;
  height: 230px;
}

.buttons {
  position: absolute;
  bottom: 20px;
  left: 0;
  width: 100%;
}

button {
  border: 0;
  border-radius: 25px;
  padding: 12px 24px;
  margin: 4px;
  color: white;
  background: linear-gradient(135deg, #7b35bd, #b66cff);
  font-weight: bold;
  font-size: 15px;
  cursor: pointer;
}

.dots {
  margin-top: 18px;
  color: #7133a8;
  letter-spacing: 4px;
}

.heart {
  position: fixed;
  font-size: 25px;
  animation: float 7s linear infinite;
  opacity: .65;
}

@keyframes float {
  from {
    transform: translateY(110vh) rotate(0);
  }
  to {
    transform: translateY(-15vh) rotate(360deg);
  }
}
</style>
</head>

<body>

<div class="heart" style="left:8%;animation-delay:0s">💜</div>
