<div class="dots" id="dots">● ○ ○ ○</div>

<div class="buttons">
  <button onclick="back()">← Back</button>
  <button onclick="next()">Next →</button>
</div>

</div>


<script>
let page = 1;

function showPage() {
  for (let i = 1; i <= 4; i++) {
    document.getElementById("p" + i)
      .classList.toggle("active", i === page);
  }

  const dots = [
    "● ○ ○ ○",
    "○ ● ○ ○",
    "○ ○ ● ○",
    "○ ○ ○ ●"
  ];

  document.getElementById("dots").textContent = dots[page - 1];
}

function next() {
  if (page < 4) {
    page++;
    showPage();
  }
}

function back() {
  if (page > 1) {
    page--;
    showPage();
  }
}
</script>

</body>
</html>